[Unit]
Description=Cadence media library daemon
After=local-fs.target

[Service]
Type=simple
User={{ service_user }}
Group={{ service_group }}
{% if volume == "" %}StateDirectory={{ name }}
StateDirectoryMode=0700
CacheDirectory={{ name }}
CacheDirectoryMode=0700
{% endif %}
RuntimeDirectory={{ name }}
RuntimeDirectoryMode=0700
UMask=0077
{% if volume != "" %}ExecStart={{ executable }} --volume {{ volume }} --socket "%t/{{ name }}/media.sock" --policy lean
{% else %}ExecStart={{ executable }} --database "%S/{{ name }}/library.sqlite" --cache "%C/{{ name }}" --socket "%t/{{ name }}/media.sock" --policy lean{% if availability == "host" %} --availability host{% endif %}
{% endif %}Restart=on-failure
RestartSec=3
TimeoutStopSec=60
NoNewPrivileges=true
{% if volume == "" and availability != "host" %}ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
{% endif %}

[Install]
WantedBy=multi-user.target
